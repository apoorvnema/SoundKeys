{
  appId: "com.soundkeys.app",
  productName: "SoundKeys",
  copyright: "Copyright © 2026 SoundKeys",
  directories: {
    buildResources: "build",
    output: "release"
  },
  files: [
    "out/**/*"
  ],
  extraResources: [
    {
      from: "sounds/",
      to: "sounds/"
    },
    {
      from: "build/",
      to: "build/"
    }
  ],
  asarUnpack: [
    "**/node_modules/uiohook-napi/**/*",
    "**/node_modules/sql.js/**/*"
  ],
  win: {
    forceCodeSigning: false,
    verifyUpdateCodeSignature: false,
    target: [
      {
        target: "portable",
        arch: ["x64"]
      },
      {
        target: "nsis",
        arch: ["x64"]
      }
    ],
    icon: "build/icon.ico"
  },
  nsis: {
    oneClick: false,
    allowToChangeInstallationDirectory: true,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: "SoundKeys"
  },
  portable: {
    artifactName: "SoundKeys-${version}-portable.exe"
  }
}
